    "@fortawesome/vue-fontawesome": "3.3.3",
    "@rollup/plugin-strip": "3.0.4",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "v10.10.0",
    "globals": "17.8.0",
    "happy-dom": "20.11.1",
    "sinon": "22.1.0",
    "vite": "8.1.5",
